{
  "name": "simhammer-desktop",
  "version": "4.3.3-rex.7",
  "private": true,
  "homepage": "https://simhammer.com",
  "author": {
    "name": "sortbek",
    "email": "simhammer@sortbek.com"
  },
  "main": "main.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "npm run build:frontend && npm run build:backend && electron-builder",
    "publish": "node scripts/publish.js",
    "build:frontend": "npm run --prefix ../frontend build:desktop && node scripts/copy-frontend.js",
    "build:backend": "node scripts/build-backend.js"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.simhammer.app",
    "productName": "Magic World Sim",
    "files": [
      "main.js",
      "preload.js",
      "src/main/**/*",
      "scripts/**/*.js"
    ],
    "extraResources": [
      {
        "from": "resources/data",
        "to": "data"
      },
      {
        "from": "resources/frontend",
        "to": "frontend"
      },
      {
        "from": "resources/backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "MagicWorldSim-Setup-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "artifactName": "MagicWorldSim-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "MagicWorldSim-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "Rex0519",
      "repo": "simhammer"
    }
  }
}
